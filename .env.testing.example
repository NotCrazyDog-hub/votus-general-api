# Ambiente de TESTE — modelo de .env.testing (que está no .gitignore).
#
#   cp .env.testing.example .env.testing
#   php artisan key:generate --env=testing
#
# IMPORTANTE: este arquivo aponta para um banco LOCAL de teste (MySQL do
# WAMP/XAMPP). Nunca aponte para Supabase/produção: os testes rodam
# `migrate:fresh` a cada execução e apagariam tudo.
#
# Sem `--env=testing`, o phpunit.xml força DB_CONNECTION=sqlite em memória e
# este arquivo nem é lido. Com `--env=testing`, o Laravel carrega este
# arquivo e o MySQL local é usado no lugar do SQLite.

APP_NAME=Votus
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco LOCAL de teste. Nunca apontar para Supabase/producao aqui.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=votus_testing
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
FILESYSTEM_DISK=local
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
