APP_NAME=Votus
APP_ENV=testing
APP_KEY=base64:wdZNmVxTv6+UTJvoXCINLMeiuGo5ySKBeSogZheHsI4=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Banco LOCAL de teste (WAMP/XAMPP). Nunca apontar para Supabase/producao aqui.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=votus_testing
DB_USERNAME=root
DB_PASSWORD=
# O MySQL local tem default_storage_engine=MyISAM (limite de 1000 bytes por
# chave); o unique de users.email em utf8mb4 ocupa 1020 e a migration falharia
# com "Specified key was too long". Forçar InnoDB resolve sem tocar migrations.
DB_ENGINE=InnoDB

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
FILESYSTEM_DISK=local
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false